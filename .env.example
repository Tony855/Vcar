DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Installer initializes this once from SECRET_KEY for backward compatibility; keep stable across SECRET_KEY rotations.
BOT_CREDENTIALS_ENCRYPTION_KEY=
# Generate with: python -c "from app.core.security import hash_password; print(hash_password('your-strong-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Comma-separated trusted origins; leave empty for same-origin deployment
CORS_ORIGINS=
OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_PROFILE=driving
OSRM_ENABLED=false
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_TABLE_COORDINATES=100

# Optional; /metrics is disabled (404) unless a long random bearer token is configured.
METRICS_BEARER_TOKEN=
